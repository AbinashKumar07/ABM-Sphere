# ABM Sphere Localhost & Environment Configuration Template
# Copy to .env for local overrides; never commit real secrets to source control.

PORT=8080
HOST=127.0.0.1
NODE_ENV=development

# Security & Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
MAX_BODY_BYTES=65536

# Audit Log Retention
AUDIT_MAX_ENTRIES=500
